# Neon Postgres connection string (pooled), from your Neon project dashboard
DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/endtoend_encrypt?sslmode=require

# Session JWT signing secret (32+ random bytes, e.g. `openssl rand -base64 32`)
SESSION_SECRET=change-me-to-a-long-random-value

# --- Netlify Blobs ---
# If you run `netlify dev`, these are NOT needed — Netlify auto-injects
# site context. Only required if you run `bun dev` / `vite dev` directly:
#   NETLIFY_SITE_ID   — Site configuration -> General -> Site details -> Site ID
#   NETLIFY_AUTH_TOKEN — User settings -> Applications -> Personal access tokens -> New access token
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
