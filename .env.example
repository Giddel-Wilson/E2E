# Neon Postgres connection string (pooled), from your Neon project dashboard
DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/endtoend_encrypt?sslmode=require

# Session JWT signing secret (32+ random bytes, e.g. `openssl rand -base64 32`)
SESSION_SECRET=change-me-to-a-long-random-value

# --- Backblaze B2 (S3-compatible object storage for encrypted file chunks) ---
# 1. Sign up at backblaze.com (no credit card required for private buckets)
# 2. Create a bucket, set it to Private
# 3. Account -> Application Keys -> Add a New Application Key, scoped to
#    that bucket -> gives you B2_KEY_ID and B2_APPLICATION_KEY
# 4. Bucket details page shows the Endpoint (e.g. s3.us-west-004.backblazeb2.com)
#    and the region code within it (e.g. us-west-004)
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key

# No ORIGIN / ADDRESS_HEADER / XFF_DEPTH / BODY_SIZE_LIMIT needed here —
# those were specific to adapter-node running behind a generic reverse
# proxy (Render). adapter-vercel already knows how to correctly read
# client IPs and request origin on Vercel's own infrastructure, and
# Vercel enforces its own (non-configurable) 4.5MB body limit regardless
# of any SvelteKit-level setting.
